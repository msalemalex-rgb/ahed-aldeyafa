{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/menu",
      "destination": "/api/menu-page"
    },
    {
      "source": "/i/:id.jpg",
      "destination": "/api/img?id=:id"
    },
    {
      "source": "/menu.json",
      "destination": "/api/menu"
    },
    {
      "source": "/menu-report.txt",
      "destination": "/api/menu?report=1"
    }
  ],
  "headers": [
    {
      "source": "/menu.json",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/menu-report.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/menu3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/menu3.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram",
      "permanent": true
    },
    {
      "source": "/insta",
      "destination": "/?utm_source=instagram",
      "permanent": true
    },
    {
      "source": "/wa",
      "destination": "/?utm_source=whatsapp",
      "permanent": true
    },
    {
      "source": "/snap",
      "destination": "/?utm_source=snapchat",
      "permanent": true
    },
    {
      "source": "/tt",
      "destination": "/?utm_source=tiktok",
      "permanent": true
    },
    {
      "source": "/fb",
      "destination": "/?utm_source=facebook",
      "permanent": true
    },
    {
      "source": "/x",
      "destination": "/?utm_source=twitter",
      "permanent": true
    },
    {
      "source": "/m",
      "destination": "/menu",
      "permanent": true
    }
  ]
}
